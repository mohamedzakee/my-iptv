<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><corners android:radius="22dp" />
                <gradient android:angle="270" android:startColor="#59FFFFFF" android:centerColor="#26FFFFFF" android:endColor="#33FFFFFF" />
                <stroke android:width="2dp" android:color="#E6FFFFFF" /></shape></item>
            <item android:bottom="64dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape><corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
                <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#00FFFFFF" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><corners android:radius="22dp" />
                <gradient android:angle="270" android:startColor="#2EFFFFFF" android:centerColor="#14FFFFFF" android:endColor="#1AFFFFFF" />
                <stroke android:width="1dp" android:color="#4DFFFFFF" /></shape></item>
            <item android:bottom="64dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape><corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
                <gradient android:angle="270" android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
