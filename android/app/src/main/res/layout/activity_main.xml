<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipChildren="false">

    <!-- Ambient backdrop: the focused channel's artwork, heavily blurred -->
    <ImageView
        android:id="@+id/ambient"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0.45" android:contentDescription="@null" android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false" android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="48dp" android:paddingTop="20dp" android:paddingEnd="48dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.04" android:text="@string/app_name"
                android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/updateBtn"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginEnd="14dp" android:background="@drawable/glass_button"
                android:focusable="true" android:clickable="true" android:paddingStart="20dp"
                android:paddingTop="8dp" android:paddingEnd="20dp" android:paddingBottom="8dp"
                android:text="@string/update_available" android:textColor="@color/glass_button_text"
                android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />

            <TextView
                android:id="@+id/infoBtn"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_marginEnd="14dp" android:background="@drawable/glass_button"
                android:focusable="true" android:clickable="true" android:gravity="center"
                android:text="i" android:textColor="@color/glass_button_text"
                android:textSize="15sp" android:textStyle="bold" />

            <TextClock
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/glass_panel" android:format12Hour="h:mm a"
                android:format24Hour="HH:mm" android:paddingStart="20dp" android:paddingTop="8dp"
                android:paddingEnd="20dp" android:paddingBottom="8dp"
                android:textColor="@color/text" android:textSize="15sp" />
        </LinearLayout>

        <!-- Hero: details of the focused channel -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="136dp"
            android:gravity="bottom" android:orientation="vertical"
            android:paddingStart="48dp" android:paddingEnd="48dp" android:paddingBottom="6dp">

            <TextView
                android:id="@+id/heroSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:letterSpacing="0.12" android:textAllCaps="true"
                android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text_dim" android:textSize="12sp" />

            <TextView
                android:id="@+id/heroName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text" android:textSize="32sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/heroNow"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text_dim" android:textSize="14sp" />

            <TextView
                android:id="@+id/heroNext"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1"
                android:textColor="@color/text_faint" android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:clipChildren="true" android:clipToPadding="true"
            android:fadingEdgeLength="24dp" android:requiresFadingEdge="vertical"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/numberEntry"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_marginTop="72dp" android:layout_marginEnd="48dp"
        android:background="@drawable/glass_panel" android:minWidth="120dp" android:gravity="center"
        android:paddingStart="28dp" android:paddingTop="12dp" android:paddingEnd="28dp" android:paddingBottom="12dp"
        android:textColor="@color/text" android:textSize="36sp" android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@drawable/glass_panel"
        android:gravity="center" android:padding="28dp" android:text="@string/loading"
        android:textColor="@color/text" android:textSize="15sp" />
</FrameLayout>
