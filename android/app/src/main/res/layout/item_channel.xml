<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="8dp" android:background="@drawable/card_bg"
    android:clickable="true" android:focusable="true"
    android:orientation="vertical" android:padding="12dp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent" android:layout_height="80dp"
        android:contentDescription="@null" android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:ellipsize="end" android:gravity="center"
        android:maxLines="1" android:textColor="@color/text" android:textSize="15sp" />
</LinearLayout>
