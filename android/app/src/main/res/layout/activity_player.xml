<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/black" android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="false" app:use_controller="false" app:show_buffering="always" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start" android:layout_margin="32dp"
        android:background="@color/overlay" android:gravity="center_vertical"
        android:orientation="horizontal" android:padding="16dp">

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="96dp" android:layout_height="54dp"
            android:layout_marginEnd="16dp" android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/infoName"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/infoSub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_dim" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="@color/overlay"
        android:gravity="center" android:maxWidth="600dp" android:padding="20dp"
        android:textColor="@color/text" android:textSize="18sp" android:visibility="gone" />
</FrameLayout>
