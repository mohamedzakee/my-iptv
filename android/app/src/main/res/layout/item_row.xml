<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clipChildren="false" android:orientation="vertical" android:paddingTop="12dp">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="64dp" android:textColor="@color/text_dim"
        android:textSize="20sp" android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="52dp" android:paddingTop="14dp" android:paddingEnd="52dp"
        android:paddingBottom="8dp" />
</LinearLayout>
