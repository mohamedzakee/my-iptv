<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:clipChildren="false" android:orientation="vertical" android:paddingTop="6dp">

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="48dp" android:textColor="@color/text_dim"
        android:textSize="15sp" android:textStyle="bold" />

    <!-- Vertical padding leaves room for the focused card to grow without touching the title. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rowList"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="40dp" android:paddingTop="12dp" android:paddingEnd="40dp"
        android:paddingBottom="6dp" />
</LinearLayout>
